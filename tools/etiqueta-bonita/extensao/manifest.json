{
  "manifest_version": 3,
  "name": "Etiqueta Bonita",
  "version": "1.1.0",
  "description": "Deixa as etiquetas da Shopee (PDF do UpSeller) com um quadro de conferência: quantidade, SKU e variação em destaque.",
  "permissions": [
    "downloads",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Etiqueta Bonita",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://*.upseller.cn/*",
    "https://*.upseller.com/*"
  ]
}